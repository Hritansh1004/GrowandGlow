<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_status_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">
            <ImageView
                android:id="@+id/live_status_icon_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/live_status_icon_circle_bg" />
            <ImageView
                android:id="@+id/live_status_mode_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/live_status_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_status_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="46dp"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <Chronometer
            android:id="@+id/live_status_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_status_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/live_status_action1_wrap"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="70dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:id="@+id/live_status_action1_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/live_status_pill_bg" />
            <TextView
                android:id="@+id/live_status_action1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textStyle="bold"
                android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/live_status_action2_wrap"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="70dp">
            <ImageView
                android:id="@+id/live_status_action2_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/live_status_pill_bg" />
            <TextView
                android:id="@+id/live_status_action2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textStyle="bold"
                android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
